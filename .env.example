# Copy this file to .env and fill in your values.
# All values are optional; defaults come from settings.js / config.js.

# --- Bot identity ---
PACKNAME=Knight Bot
PACK_AUTHOR=
BOT_NAME=Knight Bot
BOT_OWNER=Your Name
# Owner WhatsApp number without "+" or spaces (country code + number)
OWNER_NUMBER=919876543210
# Number used to request the pairing code in non-interactive hosts
PHONE_NUMBER=
BOT_VERSION=2.3.0

# --- Features ---
# Giphy API key used by the .gif command
GIPHY_API_KEY=
# public = everyone can use the bot | private = owner only
COMMAND_MODE=public
MAX_STORE_MESSAGES=20
STORE_WRITE_INTERVAL=10000

# --- External media/processing APIs (used by some commands) ---
API_XTEAM=
API_DZX=
API_LOL=
API_VIOLETICS=
API_NEOXR=
API_ZENZAPIS=
API_AKUARI=
API_AKUARI2=
API_NRTM=
API_BG=
API_FGMODS=
KEY_XTEAM=
KEY_LOLHUMAN=
KEY_NEOXR=
KEY_VIOLETICS=
KEY_ZENZAPIS=
KEY_FGMODS=

# --- Updates ---
UPDATE_ZIP_URL=https://github.com/cleberleonheart-maker/Knightbot-MD/archive/refs/heads/main.zip